# PostgreSQL externo acessado pela aplicação via connection string.
# Em produção, recomenda-se um PostgreSQL gerenciado (por exemplo, Supabase
# Session Pooler). Não registre aqui hostnames, usuários ou senhas reais.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Conexão explícita e de menor privilégio para CLIs de curadoria Awin.
AWIN_CURATOR_DATABASE_URL=postgresql://usuario_readonly:senha@host:5432/banco

# Segredo longo, aleatório e exclusivo de cada ambiente.
SESSION_SECRET=

# Use development no Codespaces e production na hospedagem.
NODE_ENV=development

# Mantém a superfície administrativa e collectors desativados na demo pública.
PUBLIC_DEMO_MODE=true

# Endereço institucional exibido para contato.
PUBLIC_CONTACT_EMAIL=

# URL secreta do Product Feed Awin. Não registre URL, API key ou identificadores reais.
AWIN_PRODUCT_FEED_URL=
# Identificador operacional não secreto usado em proveniência/relatórios.
AWIN_PRODUCT_FEED_ID=
UPPULSE_CATALOG_PREVIEW_ENABLED=false
